# Copy this to `.env` (repo root) and fill in. `.env` gitignored hai — kabhi commit mat karna.

# https://console.groq.com — free, grading + generation dono isi se
GROQ_API_KEY=

# https://tavily.com — web search fallback (Phase 3 se zaroori)
TAVILY_API_KEY=

VECTOR_DB=chroma

# --- optional overrides (defaults app/config.py me hain) ---
# LLM_MODEL=llama-3.3-70b-versatile
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# TOP_K=4
