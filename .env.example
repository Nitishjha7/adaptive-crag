# WARNING: this file IS committed to git. Never put a real key here.
# Real keys only ever go in `.env` — that file is gitignored.
#
#   copy .env.example .env      <- then fill in the keys in `.env`
#
# ============================================================================
# REQUIRED
# ============================================================================

# https://console.groq.com -> sign in -> API Keys -> Create API Key
# Grading, query rewrite, generation and the groundedness check all use this.
# Nothing runs without it.
GROQ_API_KEY=

# ============================================================================
# OPTIONAL — safe to leave these on their defaults
# ============================================================================

# Web search provider. Default "duckduckgo" — no API key needed.
# Set "tavily" and fill in the key below for better snippets.
# SEARCH_PROVIDER=duckduckgo

# Only needed when SEARCH_PROVIDER=tavily. https://tavily.com — free 1000/month
TAVILY_API_KEY=

VECTOR_DB=chroma

# --- model / retrieval overrides (defaults live in backend/app/config.py) ---
# LLM_MODEL=openai/gpt-oss-120b
 # EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# TOP_K=4

# Comma-separated Groq model ids to fail over to if LLM_MODEL 404s or gets
# rate-limited (this has happened for real — see docs/BUILD_PLAN.md, the
# llama-3.3-70b-versatile retirement). Empty by default: one key, one model,
# no fallback simulated unless this is set.
# LLM_FALLBACK_MODELS=openai/gpt-oss-20b

# Origins allowed to call the API, comma-separated. Default is the two local dev
# origins. The deploy image serves the frontend from the same app, so production
# is same-origin and this stays unused — set it only for a split deployment.
# CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# --- cross-query memory (backend/app/memory/) ---
# Needs no new key: episodic and semantic memory reuse GROQ_API_KEY (nothing
# extra) and the same FastEmbed model VECTOR_DB retrieval already loads — a
# second Chroma collection in the same VECTORSTORE_DIR, not a new service.
# DISABLE_MEMORY_STORE=true    forces memory off even though nothing else changed

# --- rate limiting (backend/app/rate_limit.py) ---
# /api/query, /api/query/stream and /api/upload are capped per caller: the demo
# is public and unauthenticated, and each query spends real Groq credits. Read
# endpoints are exempt. In-process, so with several instances the real ceiling
# is that multiple of the configured one.
# DISABLE_RATE_LIMIT=true      turns it off (the test suite sets this)
