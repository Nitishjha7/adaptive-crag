# ⚠️ YE FILE GIT ME COMMIT HOTI HAI. Yahan kabhi asli key mat daalna.
# Asli keys sirf `.env` me jaati hain — wo gitignored hai.
#
#   copy .env.example .env      <- phir `.env` me keys bharo
#
# ============================================================================
# ZAROORI
# ============================================================================

# https://console.groq.com -> sign in -> API Keys -> Create API Key
# Grading, query rewrite, generation aur groundedness check — chaaron isi se.
# Iske bina kuch nahi chalega.
GROQ_API_KEY=

# ============================================================================
# OPTIONAL — ye sab defaults pe chhod sakte ho
# ============================================================================

# Web search provider. Default "duckduckgo" — koi API key nahi chahiye.
# "tavily" karne pe neeche wali key bharni padegi (behtar snippets deta hai).
# SEARCH_PROVIDER=duckduckgo

# Sirf tab chahiye jab SEARCH_PROVIDER=tavily ho. https://tavily.com — free 1000/month
TAVILY_API_KEY=

VECTOR_DB=chroma

# --- model / retrieval overrides (defaults backend/app/config.py me hain) ---
# LLM_MODEL=openai/gpt-oss-120b
 # EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# TOP_K=4

# Comma-separated Groq model ids to fail over to if LLM_MODEL 404s or gets
# rate-limited (this has happened for real — see docs/BUILD_PLAN.md, the
# llama-3.3-70b-versatile retirement). Empty by default: one key, one model,
# no fallback simulated unless this is set.
# LLM_FALLBACK_MODELS=openai/gpt-oss-20b

# Origins allowed to call the API, comma-separated. Default is the two local dev
# origins. The deploy image serves the frontend from the same app, so production
# is same-origin and this stays unused — set it only for a split deployment.
# CORS_ORIGINS=http://localhost:3001,http://localhost:5173
